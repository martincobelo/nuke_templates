 addUserKnob {20 cs_ctx_tab l Splats}
 addUserKnob {26 cs_ctx_context_spacer l Context}
 addUserKnob {1 cs_ctx_show l Show t "Show the asset lives under"}
 cs_ctx_show HRG
 addUserKnob {1 cs_ctx_scene l Scene t "Scene this asset lives under" -STARTLINE}
 cs_ctx_scene "\[getenv SCENE]"
 addUserKnob {1 cs_ctx_shot l Shot t "Shot to query for assets under, can use '*' to get all valid shots or a | separate list of shots to query multiple" -STARTLINE}
 cs_ctx_shot "\[getenv SHOT]"
 addUserKnob {1 cs_ctx_task_type l "Task Type" t "The task type of the asset, '|' can be used to order multiple task type queries"}
 cs_ctx_task_type Compositing
 addUserKnob {1 cs_ctx_asset_type l "Asset Type" t "The asset's type, '|' can be used to order multiple asset type queries" -STARTLINE}
 cs_ctx_asset_type template
 addUserKnob {1 cs_ctx_label l "Asset Label" t "Label of the Asset, can be used with a regex to match, eg 'bg_v\[0-9]+_ud'"}
 cs_ctx_label nuke_env_210
 addUserKnob {1 cs_ctx_import_mode l "Import Mode" t "Import mode that was used to create this node"}
 cs_ctx_import_mode NukeTemplateImportMode
 addUserKnob {1 cs_ctx_component l Component t "Component that was imported from the Asset version" -STARTLINE}
 cs_ctx_component nuke_script
 addUserKnob {3 cs_ctx_user_version l "User Version" t "The user version number."}
 addUserKnob {26 cs_ctx_evaluation_spacer l Evaluation}
 addUserKnob {4 cs_ctx_update_mode l "Update Mode" t "Context: update the node using the context hierarchy search, eg. shot, scene, show\nAsset: updates the node to a specific Asset\nVersion: updates to a specific version, essentially freezing the node" M {Context Asset Version}}
 addUserKnob {6 cs_ctx_sort_by_status l "Sort by Status" t "Sorts by status weight and version, otherwise only by version." -STARTLINE}
 cs_ctx_sort_by_status true
 addUserKnob {6 cs_ctx_skip_rejected l "Skip Rejected" t "Skips rejected or ignored status when returning results." -STARTLINE}
 cs_ctx_skip_rejected true
 addUserKnob {3 cs_ctx_version l Version t "Set the node to the specific version, only used in 'version' mode." -STARTLINE R 1 100000}
 addUserKnob {26 cs_ctx_button_spacer l "" +STARTLINE}
 addUserKnob {22 cs_ctx_test l Test t "Tests the splats evaluation and shows the resulting query in an info panel" -STARTLINE T "nuke.display(\"__import__('csnuke.nodes.other.splats.node', fromlist=\['Splats']).Splats.test_button()\", nuke.thisNode(), 'Testing Context', 600)"}
 addUserKnob {22 cs_ctx_splat_test l "Test Splat" t "Expands the node and places the result next to the Splats" -STARTLINE T "__import__('csnuke.nodes.other.splats.node', fromlist=\['Splats']).Splats.update_button(True)"}
 addUserKnob {22 cs_ctx_splat l Splat t "Expands the node, connects it to the node graph and removes the Splats" -STARTLINE T "__import__('csnuke.nodes.other.splats.node', fromlist=\['Splats']).Splats.update_button(False)"}
 addUserKnob {22 cs_ctx_clear l Clear t "Clear the context to the environment and all the data" -STARTLINE T "__import__('csnuke.nodes.other.splats.node', fromlist=\['Splats']).Splats.clear_button()"}
 addUserKnob {1 _cs_ctx_tab_prefix +INVISIBLE}
 _cs_ctx_tab_prefix cs_ctx
 addUserKnob {1 _asset_tab_class +INVISIBLE}
 _asset_tab_class "csnuke.nodes.other.splats.node Splats"
 addUserKnob {4 cs_splats_splat_mode l " Eval Mode " t "Evaluation mode:\n - multi: splat all asset versions found with an unique asset labels. When in Context update mode will only return from the first valid shot.\n - single: splat the first asset version that is found per shot unless in Context mode in which it will only return from the first shot.\n" -STARTLINE M {multi single}}
 cs_splats_splat_mode single
 addUserKnob {20 cs_splats_advanced_tab l Advanced}
 addUserKnob {26 cs_splats_code_to_exec_label l "Code to Exec"}
 addUserKnob {43 cs_splats_exec_before l "Exec Before" t "Code that is executed before the node is splatted, nuke.thisSplat() returns the Splats tab.\nCalling nuke.thisSplat().update_internals() will update any internal nodes to their latest version before expansion."}
 addUserKnob {43 cs_splats_exec_filter l "Exec Filter" t "Code that is executed between exec_before and exec_during when the splats is filtering assets.\nthis function return a list of assets that can be reordered or filtered here.\n<b>nuke.thisSplat()</b> returns the Splats tab\n<b>splats.ordered_assets</b> - the list of ordered assets that get queried. Override this attribute to reorder the assets.\n\nExample:\nsplats.ordered_assets = sorted(sb.ordered_assets, key = lambda x: x.shot.name, reverse=True) will order assets on the reversed alphabetical order using the shot name"}
 addUserKnob {43 cs_splats_exec_during l "Exec During" t "Code that is executed during each input expansion, nuke.thisSplat() returns the Splats tab.\nCalling nuke.thisSplat().expand_internals() will expand any internal splats which can be used to query the current shot bundle or asset version using tcl.\nnuke.thisSplatData() returns a data object with the expanding stack.\n\n<b>splats_data.node</b> - the imported asset version for the stack\n<b>splats_data.nodes</b> - the branch of nodes that we expanded for the stack\n<b>splats_data.interface</b> - the interface that imported the node"}
 addUserKnob {43 cs_splats_exec_after l "Exec After" t "Code that is executed after the node is splatted.\nnuke.thisSplat() returns the Splats tab.\nnuke.thisSplatData() returns a data object with the newly created nodes.\n\n<b>splats_data.nodes</b> - list of all newly created nodes that were splatted.\n<b>splats_data.inputs</b> - a dictionary of imported node to node stack.\n<b>splats_data.outputs</b> - lists output nodes that all inputs are connected to.\n<b>splats_data.interfaces</b> - a dictionary from node to the version interface that was used to import the asset versions"}
 addUserKnob {26 cs_splats_expand_options l "Expand Options"}
 addUserKnob {3 cs_splats_expand_order l "Expand Order" t "The order that the node will be expanded relative to all other splat nodes."}
 cs_splats_expand_order 20
 addUserKnob {4 cs_splats_expand_mode l " Mode " t "Expansion mode:\n - Merge: connects all expanded branches to top most output node\n - Sequential: duplicates the top most output node and connects each expanded branch to the b-stream\n" -STARTLINE M {Merge Sequential}}
 addUserKnob {4 cs_splats_expand_direction l " Dir " t "Expansion Direction:\nDirection to expand content of splats node relative splats node." -STARTLINE M {Right Left Below}}
 addUserKnob {4 cs_splats_updatable_mode l Updatable t "Sets the updatable mode, they are:\n - Clear: Clears the Splat node and doesn't create a CsSplatSwap\n - Update: Keeps the nodes and sets the CsSplatSwap to update\n - Keep: Keeps the nodes only, CsSplatSwap node is set to not update" M {Clear Update Keep}}
