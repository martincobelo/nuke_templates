 addUserKnob {22 get_lens_map l "get lens map" T "\nfrom csnuke.utils.node import get_wrapped_node\nfrom csnuke_tools.trixter.snippets import shotUtils\nfrom cs.pipeline.show import Show\nfrom csnuke.pipeline.asset.nuke_asset_interface import import_asset_version\nfrom cs.pipeline.task import Task\ntask_object = Task()\n\n\nntn = nuke.thisNode()\nwith nuke.root():\n    read = shotUtils.topnode(ntn, 0)\n    read.setSelected(False)\n    \n    # collect lens info\n    read_label = read\[\"cs_ctx_label\"].value()\n    \n    \n    this_shot = ntn\['shot'].value()\n    this_scene = ntn\['scene'].value()\n    \n    if this_shot and this_scene:\n        show = task_object.show\n        scene = show.get_scene(this_scene)\n        shot = scene.get_shot(this_shot)\n        print('getting override')\n    else:\n        cs_node = get_wrapped_node(read)\n        asset_version = cs_node.asset_version()\n        shot = asset_version.shot\n    \n    \n    \n    \n    \n    lens = shot.get(\"cam_lens\").lower().replace(\"-\", \"_\").replace(\":\", \"_\").replace(\" \", \"_\")\n    lens_serial = shot.get(\"cam_lens_serial_num\").lower().replace(\"-\", \"_\").replace(\":\", \"_\").replace(\" \", \"_\")\n    lab = f\"<center>\{read_label\}<br>\{lens\}<br>\{lens_serial\}\"\n    read\[\"autolabel\"].setValue(\"'\" + lab + \"'\")\n    label = f\"deaberration_\{lens\}_\{lens_serial\}\"\n    print(label)\n    \n\n    deaberration_versions = \[]\n    statuses = \[\"WIP\"]\n    show = Show()\n    scene = show.get_scene(\"assets/camera\")\n    shot = scene.get_shot(\"lensGrids\")\n    for asset in shot.get_assets():\n        asset_versions = \[\n            x for x in asset.get_asset_versions() if x.status.name in statuses and label in x.label \n        ]\n        if asset_versions:\n            asset_versions = sorted(asset_versions, key=lambda a: a.version.version)\n            deaberration_versions.append(asset_versions\[-1])\n    \n    \n    lens = deaberration_versions\[0]\n    read = import_asset_version(lens).nodes\[0]\n    read.setXYpos(ntn.xpos() , ntn.ypos() - 100)\n    ntn.setInput(0,read)\n    for node in nuke.allNodes(\"Group\"):\n        if \"Deaberration\" in node.name():\n            if node.input(1) == ntn:\n                node\['refresh'].execute()\n    #lens\[\"postage_stamp\"].setValue(True)\n    \n\n\n\n\n\n\n\n\n\n" +STARTLINE}
