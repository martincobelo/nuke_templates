 addUserKnob {22 copy_corrections l "Copy Corrections" t "Copy corrections to json file for later use in Katana." T "import json\nimport os\n\nfrom PySide2 import QtWidgets, QtGui\n\nnode = nuke.thisNode()\n\nalphabet_short = \['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p']\n\nlight_groups_mod_dict = \{\}\nlg_number = 15\n\nfor lg in alphabet_short:\n\n    #reset default values\n    lg_exposure = node\['exposure_lg_%s' %lg].value()\n    lg_multiply = node\['multiply_lg_%s' %lg].value()\n    lg_modifications = \{\}\n    lg_mute = node\['disable_lg_%s' %lg].value()\n    lg_solo = node\['isolate_lg_%s' %lg].value()\n    lg_mute_corrections = node\['disableTransform_lg_%s' %lg].value()\n    lg_modified = False\n\n    #check for mute/solo\n    if lg_mute == 1:\n        lg_mute = True\n        lg_modifications\['mute'] = True\n        lg_modified = True    \n\n    if lg_solo == 1:\n        lg_solo = True\n        lg_modifications\['solo'] = True\n        lg_modified = True    \n\n\n    #check if mute_corrections is on\n    if lg_mute_corrections == 0:\n        \n        if lg_exposure != 0:\n            lg_modifications\['exposure'] = lg_exposure\n            lg_modified = True\n\n        if any(c != 1 for c in lg_multiply):\n            lg_modifications\['multiply'] = lg_multiply\n            lg_modified = True\n\n\n\n\n    if lg_modified:\n        light_groups_mod_dict\[lg] = lg_modifications\n\n\n#write to json if dict is not empty\nif light_groups_mod_dict:\n    home = os.getenv(\"HOME\") \n    home = \"/var/tmp/\"\n    json_file_path = os.path.join(home, 'lightboard.json')\n    print(json_file_path)\n    with open(json_file_path, 'w') as light_groups_mod_file:\n        json.dump(light_groups_mod_dict, light_groups_mod_file, indent=2)\n\nelse:\n\n    w = QtWidgets.QWidget()\n    QtWidgets.QMessageBox.information(w, \"Couldn't find corrections\", \"Your current LightBoard does not seem to contain any corrections. Nothing copied.\")" +STARTLINE}
 addUserKnob {22 reset_all_corrections l "Reset All Corrections" -STARTLINE T "node = nuke.thisNode()\n\nlg_number = 15\n\nalphabet_short = \['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p']\n\ndef reset(knobname, val):\n    for lg in alphabet_short:\n        mute = node\['%s_lg_%s' %(knobname, lg)].setValue(val)\n\n#this is pretty stupid, but the only way that I made it work\nreset('disable', False)\nreset('isolate', False)\nreset('disableTransform', False)\nreset('exposure', 0)\nreset('multiply', \[1,1,1,1])\nreset('group', False)\n\nnode.knob(\"updateIcons\").execute()"}
