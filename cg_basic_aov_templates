 addUserKnob {22 copyValuesLB l "Copy Values from Selected LightBoard" T "nt = nuke.thisNode()\nwith nuke.Root():\n    ns = nuke.selectedNode()\n\nfor k in nt.knobs():\n    if k in ns.knobs() and k not in \[\"xpos\",\"ypos\",\"name\",\"knobChanged\", \"label\", \"note_font_size\", \"note_font_color\"] and 'disable_' in k:\n        nt\[k].fromScript(ns\[k].toScript())\n\nnt.knob(\"updateIcons\").execute()" +STARTLINE}
 addUserKnob {22 createNewLightBoard l "Create New LightBoard" T "nt = nuke.thisNode()\nnukescripts.clear_selection_recursive()\nwith nuke.Root():\n    ns = nuke.createNode(\"CsLightBoard\")\n    ns.setXYpos(nt.xpos(),(n.ypos()+100))\n\nfor k in ns.knobs():\n    if k in nt.knobs() and k not in \[\"xpos\",\"ypos\",\"name\",\"knobChanged\", \"label\", \"note_font_size\", \"note_font_color\"]:\n        ns\[k].fromScript(nt\[k].toScript())" +STARTLINE}
