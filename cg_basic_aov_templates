 addUserKnob {22 updateIcons l "Update Preview Icons" T "n = nuke.thisNode()\nk = nuke.thisKnob()\n\n#alphabet = \['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z']\nalphabet_short = \['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p']\n\nfor lg in alphabet_short:\n    if n\['disable_lg_' + str(lg)].getValue() == 0:\n        n\['mute_info_lg_' + str(lg)].setValue('<p style=\"color:rgb(80,80,80);\">\[M]</p>')\n    else:\n        n\['mute_info_lg_' + str(lg)].setValue('<b><p style=\"color:rgb(215,40,40);\">\[M]</p>')\n        \n    if n\['isolate_lg_' + str(lg)].getValue() == 0:\n        n\['solo_info_lg_' + str(lg)].setValue('<p style=\"color:rgb(80,80,80);\">\[S]</p>')\n    else:\n        n\['solo_info_lg_' + str(lg)].setValue('<b><p style=\"color:rgb(200,200,40);\">\[S]</p>')\n        \n    if n\['disableTransform_lg_' + str(lg)].getValue() == 0:\n        if n\['multiply_lg_' + str(lg)].getValue() != \[1.0, 1.0, 1.0, 1.0] or n\['exposure_lg_' + str(lg)].getValue() != 0:\n            n\['corr_info_lg_' + str(lg)].setValue('<b><p style=\"color:rgb(40,215,40);\">\[C]</p>')\n            n\['corrected_lg_' + str(lg)].setValue(1)\n        else:\n            n\['corr_info_lg_' + str(lg)].setValue('<p style=\"color:rgb(80,80,80);\">\[C]</p>')\n            n\['corrected_lg_' + str(lg)].setValue(0)\n    else:\n        n\['corr_info_lg_' + str(lg)].setValue('<p style=\"color:rgb(80,80,80);\">\[C]</p>')\n        n\['corrected_lg_' + str(lg)].setValue(0)\n\n      \n            \n            " +STARTLINE}
